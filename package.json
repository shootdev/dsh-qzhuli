{
  "name": "dsh-qzhuli",
  "version": "0.1.0",
  "description": "Q助理（QZhuli）网关插件 for DeepSeek Harness：把 Q助理手机/电脑端会话接入 Harness Agent（imnut 协议，扫码绑定 + WebSocket 收消息 + HTTP 推消息）",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./gateway": {
      "types": "./lib/gateway/index.d.mts",
      "default": "./lib/gateway/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "gen:paths": "node scripts/gen-tsconfig-paths.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json --noEmit",
    "build": "tsdown -c tsdown.index.config.ts",
    "build:client": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0",
    "@deepseek-ai/dsh-agent": ">=0.2.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0",
    "@deepseek-ai/dsh-brand": ">=0.2.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.0",
    "@deepseek-ai/dsh-session": ">=0.2.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0",
    "@deepseek-ai/dsh-session-query": ">=0.2.0",
    "@deepseek-ai/dsh-session-title": ">=0.2.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
